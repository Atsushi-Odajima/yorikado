{
  "name": "yorikado",
  "version": "1.0.0",
  "private": true,
  "description": "Yorikado - 商店街の窓口（加盟店と事務局のWebアプリ）",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset:demo": "node --env-file-if-exists=.env.local scripts/db-reset-demo.mjs",
    "jobs:dev": "node --env-file-if-exists=.env.local --import tsx scripts/run-jobs.ts --loop",
    "jobs:once": "node --env-file-if-exists=.env.local --import tsx scripts/run-jobs.ts",
    "verify-env": "node --env-file-if-exists=.env.local --import tsx scripts/verify-env.ts",
    "export-tenant": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/export-tenant.ts",
    "perf": "node --env-file-if-exists=.env.local --import tsx scripts/perf.ts",
    "backup:check": "node --env-file-if-exists=.env.local --import tsx scripts/backup-restore-check.ts",
    "release:zip": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.2.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "fflate": "0.8.3",
    "next": "16.4.0",
    "nodemailer": "10.0.16",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "supabase": "2.120.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.56.1"
    }
  }
}
