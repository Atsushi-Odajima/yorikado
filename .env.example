# ---------------------------------------------------------------------------
# Yorikado environment template. Copy to .env.local (development) and fill in.
# Values here are placeholders. NEVER commit real values. No variable uses the
# NEXT_PUBLIC_ prefix: every value below is server-only.
# ---------------------------------------------------------------------------

# demo | live. DEMO and LIVE must be different Supabase projects, storage,
# secrets and domains. `npm run verify-env` checks the DB marker matches.
APP_ENV=demo

# Public origin of this app (used for CSRF Origin checks, links in emails,
# Auth redirect URLs). Must be https:// for LIVE and for iPhone camera tests.
APP_BASE_URL=http://localhost:3000

# Supabase project (local: printed by `npm run db:start`).
SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...) - used server-side only in this BFF design.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) - server only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Scripts/tests only (seed, integration tests). Local default shown.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 256-bit+ random keys, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation: set the new key + increment *_VERSION, move the old key into
# *_KEYS_OLD as "<version>:<base64>" (semicolon separated). See docs/SECURITY.txt.
COUPON_HMAC_KEY=
COUPON_HMAC_KEY_VERSION=1
COUPON_HMAC_KEYS_OLD=
EXPORT_ENCRYPTION_KEY=
EXPORT_ENCRYPTION_KEY_VERSION=1
EXPORT_ENCRYPTION_KEYS_OLD=

# Secret for POST /api/v1/internal/jobs/run (cron). 32+ random chars.
JOB_RUNNER_SECRET=

# Mail: none | sink | smtp. Local development: smtp to the Supabase local
# inbox (Mailpit) at 127.0.0.1:54325, browse http://127.0.0.1:54324.
# Production: only an SMTP account contracted by the operator.
MAIL_PROVIDER=smtp
MAIL_FROM=Yorikado <no-reply@example.invalid>
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
